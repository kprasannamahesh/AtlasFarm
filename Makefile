.PHONY: infra-up infra-down run-control run-worker build test lint

infra-up:
	docker compose -f deploy/docker-compose.yml up -d

infra-down:
	docker compose -f deploy/docker-compose.yml down

run-control:
	go -C control-plane run ./cmd/server

run-worker:
	go -C worker-agent run ./cmd/worker

build:
	go -C control-plane build ./...
	go -C worker-agent build ./...
	go -C scheduler build ./...

test:
	go -C control-plane test ./...
	go -C worker-agent test ./...
	go -C scheduler test ./...

lint:
	go -C control-plane vet ./...
	go -C worker-agent vet ./...
	go -C scheduler vet ./...
